---
import PostTitle from "@/components/PostTitle.astro";
import Layout from "@/layouts/Layout.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

const posts = await getSinglePage("blog");
---

<Layout>
	<main class="flex flex-col items-center justify-center">
		<div class="w-4/5 lg:w-2/3 xl:w-1/2 min-h-[calc(100vh-100px)]">
			<section class="mt-20 mb-20">
				<h1 class="text-center text-7xl">Latest Posts</h1>
			</section>
			<section class="flex flex-col items-center justify-center gap-5">
				{posts.map((post) => (
    		        <hr class="w-full border border-solid border-[#404040]" />
    				<a href={`/blog/${post.id}`}>
       					<div class="flex flex-row items-start justify-between">
      						<PostTitle
      							title={post.data.title}
      							postId={post.id}
      							variant="normal"
      							class="mb-2 text-3xl font-extrabold uppercase"
      						/>
      						<div class="text-lg text-gray-400 w-1/4">2026-05-24</div>
       					</div>
       					<p class="text-gray-400 text-xl">
      						{post.data.description}
       					</p>
    				</a>
				))}
				<hr class="w-full border border-solid border-[#404040]" />
			</section>
		</div>
	</main>
</Layout>

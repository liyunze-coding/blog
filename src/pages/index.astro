---
import PostTitle from "@/components/PostTitle.astro";
import Layout from "@/layouts/Layout.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";

function formatDate(date: Date) {
  return date.toLocaleDateString("en-CA");
}

const posts = await getSinglePage("blog");
const sortPostByDate = sortByDate(posts);
---

<Layout title="Ryan's Blog" description="Blog posts about tech, programming and streaming">
	<main class="flex flex-col items-center justify-center">
		<div class="w-4/5 lg:w-2/3 xl:w-1/2 min-h-[calc(100vh-100px)]">
			<section class="mt-20 mb-20">
				<h1 class="text-center text-7xl">Ryan's Blog</h1>
			</section>
			<section class="flex flex-col items-center justify-center gap-5">
				{sortPostByDate.map((post) => (
    		        <hr class="w-full border border-solid border-[#404040]" />
    				<a href={`/blog/${post.id}`} class="w-full">
       					<div class="w-full flex flex-row items-start justify-between">
      						<PostTitle
      							title={post.data.title}
      							postId={post.id}
      							variant="normal"
      							class="mb-2 text-3xl font-extrabold uppercase"
      						/>
      						<div class="text-lg text-gray-400 w-1/4 text-right">{formatDate(post.data.date)}</div>
       					</div>
       					<p class="text-gray-400 text-xl">
      						{post.data.description}
       					</p>
    				</a>
				))}
				<hr class="w-full border border-solid border-[#404040]" />
			</section>
		</div>
	</main>
</Layout>

---
import Layout from "./Layout.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
	<div class="flex flex-col items-center justify-start">
		<div class="w-4/5 pt-40 lg:w-3xl">
			<slot />
		</div>
	</div>
</Layout>

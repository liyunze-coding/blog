---
interface Props {
	title: string;
	description: string;
	thumbnail?: string;
	metaURL?: string;
}

import "@/styles/global.css";
import FooterComponent from "@/components/Footer.astro";
import { ClientRouter } from "astro:transitions";
const { title, description, thumbnail, metaURL } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" /><meta
			name="keywords"
			content="blog, rythondev, ryan"
		/>
		<meta name="author" content="RythonDev" />
		<meta name="theme-color" content="#2B2D31" />

		{thumbnail && <meta name="twitter:image" content={thumbnail} />}

		{metaURL && <meta name="og:url" content={metaURL} />}

		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<slot />
		<FooterComponent />
	</body>
</html>
